# Plaintext local overrides for apps/api (gitignored as apps/api/.env.local).
# Copy to apps/api/.env.local and fill in real values.
# Contributors without Dotenv Armor boot from this file alone — see AGENTS.md
# "Local development with E2B".

# ── Required for any local API boot ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
SUPABASE_JWT_SECRET=replace-with-local-supabase-jwt-secret
API_KEY_SECRET=dev-local-api-key-secret-please-32chars
TUNNEL_SIGNING_SECRET=dev-local-tunnel-signing-secret-32chars
KORTIX_BILLING_INTERNAL_ENABLED=false
INTERNAL_KORTIX_ENV=dev
ENV_MODE=local
PORT=8008

# ── E2B sandbox provider (local-dev default when set without PLATINUM_API_KEY) ─
# Get a key: https://e2b.dev → Dashboard → API Keys
ALLOWED_SANDBOX_PROVIDERS=e2b
E2B_API_KEY=
# Cluster base domain (no scheme). Default e2b.dev. Self-hosted E2B: your domain.
E2B_DOMAIN=e2b.dev
# Optional ready fallback template alias/id. The snapshot builder overrides this
# with per-project templates when it has built one. Build once with:
#   pnpm --filter kortix-api exec e2b template build
# or see apps/sandbox/e2b.toml.
E2B_TEMPLATE=

# Optional E2B timeouts (ms). Defaults shown; omit to use defaults.
# KORTIX_E2B_RUNTIME_BACKSTOP_MS=3600000
# KORTIX_E2B_REMOVE_TIMEOUT_MS=25000
# KORTIX_E2B_RENEW_TIMEOUT_MS=25000
# KORTIX_E2B_STOP_TIMEOUT_MS=25000
# KORTIX_E2B_RENEWAL_TOLERANCE_MS=120000

# Tunnel is off by default when the first ALLOWED_SANDBOX_PROVIDERS entry is e2b.
# Force off even for platinum/daytona: KORTIX_DEV_TUNNEL=0

# ── Optional: keep Platinum available alongside E2B ─────────────────────────
# ALLOWED_SANDBOX_PROVIDERS=e2b,platinum
# PLATINUM_API_KEY=
# PLATINUM_API_URL=https://api.platinum.dev
